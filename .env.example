# Supabase service role key — used ONLY by scripts/seed-cafes.ts to bypass
# RLS for writes. Never expose this in client-side code or commit a real
# value. Get it from Project Settings -> API -> service_role key.
SUPABASE_SERVICE_ROLE_KEY=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Mapbox (map rendering)
NEXT_PUBLIC_MAPBOX_TOKEN=

# Google Places (seed data ingestion)
GOOGLE_PLACES_API_KEY=
